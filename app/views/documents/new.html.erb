<% content_for :title, "New document | Ask the Docs" %>

<div class="narrow-page">
  <%= link_to documents_path, class: "back-link" do %>
    <span aria-hidden="true">&larr;</span> Back to documents
  <% end %>

  <section class="page-heading page-heading--compact">
    <div>
      <p class="eyebrow">Document library</p>
      <h1>Add a document</h1>
      <p class="page-heading__description">Give your document a clear title and add the source content below.</p>
    </div>
  </section>

  <div class="form-card">
    <%= form_with model: @document, class: "form-stack" do |form| %>
      <% if @document.errors.any? %>
        <div class="validation-errors" role="alert">
          <h2>Please check the following:</h2>
          <ul>
            <% @document.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-field">
        <%= form.label :title %>
        <%= form.text_field :title, required: true, autofocus: true,
          placeholder: "e.g. Product handbook" %>
        <p class="form-hint">Use a name that will be easy to recognize later.</p>
      </div>

      <div class="form-field">
        <%= form.label :body, "Document content" %>
        <%= form.textarea :body, required: true, rows: 18,
          placeholder: "Paste or write your document content here..." %>
      </div>

      <div class="form-actions">
        <%= link_to "Cancel", documents_path, class: "button button--secondary" %>
        <%= form.submit "Create document", class: "button button--primary" %>
      </div>
    <% end %>
  </div>
</div>
